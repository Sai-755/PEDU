PORT=5000
# Set to the number of trusted reverse proxies in front of the API.
# TRUST_PROXY_HOPS=1
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=pvgj_education
DB_SSL=false
# Optional path to your MySQL provider CA certificate when DB_SSL=true
# DB_SSL_CA=/absolute/path/to/mysql-ca.pem
DB_CONNECTION_LIMIT=10
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash



# Verification links must use an address your phone can reach.
# Same Wi-Fi: http://<your-PC-LAN-IPv4>:5000/api
# Deployed API: https://<your-public-backend-host>/api
API_BASE_URL=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=PVGJ <no-reply@example.com>
