PORT=5000
NODE_ENV=production
CLIENT_ORIGIN=https://www.yourdomain.com,https://yourdomain.com
API_BASE_URL=https://api.yourdomain.com/api
# Set to the verified number of trusted reverse-proxy hops (often 1 on a PaaS).
TRUST_PROXY_HOPS=1
DB_HOST=your-managed-mysql-host
DB_PORT=3306
DB_USER=pvgj_app
DB_PASSWORD=replace-with-a-long-random-database-password
DB_NAME=pvgj_education
DB_SSL=true
# Optional if your database provider requires a custom CA certificate:
# DB_SSL_CA=/absolute/path/to/provider-ca.pem
DB_CONNECTION_LIMIT=10
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=replace-with-a-secret
EMAIL_FROM=PVGJ <no-reply@yourdomain.com>
